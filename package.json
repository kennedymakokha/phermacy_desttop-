{
  "name": "phermecy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Phermercy Pharmacy Management Desktop Application",
  "author": "Phermercy",
  "main": "electron/main.ts",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron electron/main.ts\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:build:appimage": "npm run build && electron-builder --linux AppImage",
    "electron:build:deb": "npm run build && electron-builder --linux deb"
  },
  "build": {
    "appId": "com.phermecy.desktop",
    "productName": "Phermercy",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asar": true,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "executableName": "phermecy"
    },
    "npmRebuild": true
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.4.3",
    "wait-on": "^8.0.1"
  }
}
